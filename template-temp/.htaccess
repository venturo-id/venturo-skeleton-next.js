# venturo.id static deploy — Apache / cPanel shared hosting
# SEO redirects + clean URLs + caching

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 301: /index.html -> /  (avoid duplicate content)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# 301: dead URL pernah terindeks -> homepage
RewriteRule ^professional-programmer-kota-malang/?$ / [L,R=301]

# Clean URLs: /slug -> /slug/index.html (jika folder ada)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# Caching: aset hash immutable (1 tahun), html no-cache
<IfModule mod_headers.c>
  <FilesMatch "\.(png|svg|jpg|jpeg|webp|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers (Lighthouse Best Practices; bukan faktor ranking langsung).
  # CSP sengaja TIDAK dipasang: mirror Figma pakai inline style/script + GA, mudah rusak.
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# MIME (jaga-jaga host lama)
AddType application/json .json
AddType font/woff2 .woff2
AddType image/svg+xml .svg

ErrorDocument 404 /index.html
